rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin Helper Function
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email in ['admin@koon.bau.jo', 'hussienaldayyat@gmail.com'];
    }
    
    // Validation Helpers
    function isValidMessage(data) {
      let content = data.keys().hasAny(['message']) ? data.message :
                    data.keys().hasAny(['text']) ? data.text :
                    data.keys().hasAny(['content']) ? data.content :
                    data.keys().hasAny(['quote']) ? data.quote : '';
      
      return content is string && content.size() >= 5 && content.size() <= 2000;
    }
    
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }

    // Material Donations (Consolidated & Fixed)
    match /materialDonations/{doc} {
      allow read, write: if true;
    }
    
    // QnA / Suggestions
    match /qna/{doc} {
      allow read: if resource.data.isPublic == true || isAdmin();
      allow create: if isValidMessage(request.resource.data) && (request.resource.data.type is string);
      allow update, delete: if isAdmin();
    }
    
    match /suggestions/{doc} {
      // Admin dashboard reads without Firebase Auth → allow all reads
      allow read: if true;
      allow create: if isValidMessage(request.resource.data) && (request.resource.data.type is string);
      allow update, delete: if true;  // custom-auth admin dashboard manages these
    }

    // Question Reports
    match /question_reports/{report} {
      allow read, write: if true;
    }

    // Page Views / Analytics
    match /page_views/{view} {
      // Admin dashboard reads these without Firebase Auth → allow all reads
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Question Edits (admin corrections applied live in Quiz.jsx for all students)
    match /question_edits/{edit} {
      allow read, write: if true;
    }

    // Subscribers
    match /subscribers/{doc} {
      allow read, delete: if isAdmin();
      allow create: if isValidEmail(request.resource.data.email);
    }

    // Testimonials
    match /testimonials/{doc} {
      // Admin dashboard reads all testimonials (approved or not)
      allow read: if true;
      allow create: if isValidMessage(request.resource.data);
      allow update, delete: if true;  // admin dashboard manages approvals
    }

    // Other Collections
    match /quizContributions/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;  // admin dashboard manages approvals and deletions
    }

    match /nashmi_chat/{doc} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Campaign Archives
    match /campaignArchives/{doc} {
      allow read, write: if true;
    }

    // System Configs
    match /system_configs/{doc} {
      allow read, write: if true;
    }

    // Material Exchange Audit Logs
    match /materialExchangeLogs/{doc} {
      allow read, write: if true;
    }

    // Coordinator & Staff Activity Statuses
    match /staff_status/{doc} {
      allow read, write: if true;
    }

    // Delivery Schedules (shared table for coordinators & admin)
    match /deliverySchedules/{doc} {
      allow read, write: if true;
    }

    // Dynamic Quiz Management
    match /quiz_subjects/{doc} {
      allow read, write: if true;
    }
    match /quiz_parts/{doc} {
      allow read, write: if true;
    }
    match /quiz_questions/{doc} {
      allow read, write: if true;
    }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
