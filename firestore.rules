rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             (('email' in request.auth.token && request.auth.token.email in ['admin@koon.bau.jo', 'hussienaldayyat@gmail.com', 'hussienaldayyat2002@gmail.com']) ||
              ('admin' in request.auth.token && request.auth.token.admin == true));
    }
    
    // Validation Helpers
    function isValidMessage(data) {
      let content = data.keys().hasAny(['message']) ? data.message :
                    data.keys().hasAny(['text']) ? data.text :
                    data.keys().hasAny(['content']) ? data.content :
                    data.keys().hasAny(['quote']) ? data.quote : '';
      
      return content is string && content.size() >= 3 && content.size() <= 4000;
    }
    
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }

    // Material Donations
    match /materialDonations/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }
    
    // QnA / Suggestions
    match /qna/{doc} {
      allow read: if resource.data.isPublic == true || isAuthenticated();
      allow create: if isValidMessage(request.resource.data) && (request.resource.data.type is string);
      allow update, delete: if isAuthenticated();
    }
    
    match /suggestions/{doc} {
      allow read: if true;
      allow create: if isValidMessage(request.resource.data) && (request.resource.data.type is string);
      allow update, delete: if isAuthenticated();
    }

    // Question Reports
    match /question_reports/{report} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Page Views / Analytics
    match /page_views/{view} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Question Edits (admin corrections applied live in Quiz.jsx for all students)
    match /question_edits/{edit} {
      allow read: if true;
      allow write: if true;
    }

    // Subscribers
    match /subscribers/{doc} {
      allow read, delete: if isAuthenticated();
      allow create: if isValidEmail(request.resource.data.email);
    }

    // Testimonials
    match /testimonials/{doc} {
      allow read: if true;
      allow create: if isValidMessage(request.resource.data);
      allow update, delete: if isAuthenticated();
    }

    // Quiz Contributions
    match /quizContributions/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    match /nashmi_chat/{doc} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Campaign Archives
    match /campaignArchives/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // System Configs (Public read for site settings, authenticated write)
    match /system_configs/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Material Exchange Audit Logs
    match /materialExchangeLogs/{doc} {
      allow read, write: if isAuthenticated();
    }

    // Coordinator & Staff Activity Statuses
    match /staff_status/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Delivery Schedules (shared table for coordinators & admin)
    match /deliverySchedules/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Dynamic Quiz Management (admin-only via custom auth + anonymous Firebase session)
    match /quiz_subjects/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /quiz_parts/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /quiz_questions/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Academic Courses Management
    match /academic_courses/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Material & Difficulty Ratings (written by any visitor, readable by admin)
    match /material_ratings/{doc} {
      allow read: if true;
      allow create: if request.resource.data.itemId is string
                    && request.resource.data.type in ['star', 'difficulty']
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if isAuthenticated();
    }

    // Notice Board (admin creates notices, all users can read)
    match /notices/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Default Rule: Authenticated Only
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
